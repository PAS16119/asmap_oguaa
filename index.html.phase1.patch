+// ══════════════════════════════════════════════════
+// AUTH — Supabase Auth (phase 1). Passwords are checked by Supabase, never by this file.
+// ══════════════════════════════════════════════════
+var AUTH_EMAIL_DOMAIN = 'asmap-oguaa.vercel.app'; // must match the Edge Functions
+var AUTH = { access:'', refresh:'', exp:0 };
+var _refreshing = null;
+
+function authEmail(username) {
+  return (username||'').trim().toLowerCase().replace(/[^a-z0-9._-]/g,'_') + '@' + AUTH_EMAIL_DOMAIN;
+}
+function setAuthHeader(token) {
+  HDR = Object.assign({}, HDR, { 'Authorization': 'Bearer ' + (token || SUPA_KEY) });
+}
+function authStore(d) {
+  AUTH.access = d.access_token; AUTH.refresh = d.refresh_token;
+  AUTH.exp = Date.now() + (d.expires_in || 3600) * 1000;
+  setAuthHeader(AUTH.access);
+}
+async function authSignIn(username, password) {
+  const r = await fetch(SUPA_URL + '/auth/v1/token?grant_type=password', {
+    method:'POST', headers:{ 'apikey':SUPA_KEY, 'Content-Type':'application/json' },
+    body: JSON.stringify({ email: authEmail(username), password: password })
+  });
+  if (!r.ok) return null;
+  const d = await r.json(); authStore(d); return d;
+}
+async function ensureFreshToken() {
+  if (!AUTH.refresh) return true;
+  if (Date.now() < AUTH.exp - 120000) return true;
+  if (_refreshing) return _refreshing;
+  _refreshing = (async function(){
+    try {
+      const r = await fetch(SUPA_URL + '/auth/v1/token?grant_type=refresh_token', {
+        method:'POST', headers:{ 'apikey':SUPA_KEY, 'Content-Type':'application/json' },
+        body: JSON.stringify({ refresh_token: AUTH.refresh })
+      });
+      if (!r.ok) return false;
+      authStore(await r.json()); return true;
+    } catch(e) { return false; }
+    finally { _refreshing = null; }
+  })();
+  return _refreshing;
+}
+async function authSignOut() {
+  try {
+    if (AUTH.access) await fetch(SUPA_URL + '/auth/v1/logout', { method:'POST', headers:{ 'apikey':SUPA_KEY, 'Authorization':'Bearer '+AUTH.access } });
+  } catch(e) {}
+  AUTH = { access:'', refresh:'', exp:0 };
+  setAuthHeader('');
+}
+async function callAdminUsers(action, payload) {
+  await ensureFreshToken();
+  const r = await fetch(SUPA_URL + '/functions/v1/admin-users', {
+    method:'POST',
+    headers:{ 'Content-Type':'application/json', 'apikey':SUPA_KEY, 'Authorization':'Bearer '+AUTH.access },
+    body: JSON.stringify(Object.assign({ action: action }, payload))
+  });
+  const d = await r.json().catch(function(){ return {}; });
+  if (!r.ok) throw new Error(d.error || ('HTTP ' + r.status));
+  return d;
+}
+function mapProfile(p) {
+  return { id:p.legacy_id, authId:p.id, username:p.username, name:p.full_name, role:p.role,
+    classes:p.assigned_classes||[], active:p.is_active, permissions:p.permissions||[],
+    phone:p.phone||'', dept:p.dept||'', house:p.house||'', teacherLink:p.teacher_link||'',
+    mustChange:!!p.must_change_password };
+}
+
